[sub_resource type="GDScript" id="GDScript_68yl7"]
resource_name = "remUnuseddoors"
script/source = "extends Node




func RemoveUnusedDoor():
	for door in get_parent().get_parent().get_doors():
		print(door)
		if door.get_room_leads_to() != null:
			door.door_node.queue_free()


func _on_dungeon_room_3d_dungeon_done_generating() -> void:
	RemoveUnusedDoor()
"

