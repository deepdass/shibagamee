code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 speed;
uniform sampler2D maintexture;
uniform float alphapower;
uniform sampler2D maintexture2;
uniform float gra_power = 1.0;



void fragment() {
// Input:11
	vec4 n_out11p0 = COLOR;


// VectorDecompose:9
	float n_out9p0 = n_out11p0.x;
	float n_out9p1 = n_out11p0.y;
	float n_out9p2 = n_out11p0.z;
	float n_out9p3 = n_out11p0.w;


// VectorCompose:12
	vec3 n_out12p0 = vec3(n_out9p0, n_out9p1, n_out9p2);


// Input:7
	float n_out7p0 = TIME;


// Vector2Parameter:14
	vec2 n_out14p0 = speed;


// VectorOp:8
	vec2 n_out8p0 = vec2(n_out7p0) * n_out14p0;


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out8p0 * n_in6p1 + UV;


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(maintexture, n_out6p0);


// VectorDecompose:4
	float n_out4p0 = n_out16p0.x;
	float n_out4p1 = n_out16p0.y;
	float n_out4p2 = n_out16p0.z;
	float n_out4p3 = n_out16p0.w;


// FloatParameter:13
	float n_out13p0 = alphapower;


// FloatOp:5
	float n_out5p0 = pow(n_out4p0, n_out13p0);


// FloatOp:10
	float n_out10p0 = n_out9p3 * n_out5p0;


	vec4 n_out22p0;
// Texture2D:22
	n_out22p0 = texture(maintexture2, UV);


// VectorDecompose:23
	float n_out23p0 = n_out22p0.x;
	float n_out23p1 = n_out22p0.y;
	float n_out23p2 = n_out22p0.z;
	float n_out23p3 = n_out22p0.w;


// FloatParameter:19
	float n_out19p0 = gra_power;


// FloatOp:18
	float n_out18p0 = pow(n_out23p0, n_out19p0);


// FloatOp:20
	float n_out20p0 = n_out10p0 * n_out18p0;


// Output:0
	ALBEDO = n_out12p0;
	ALPHA = n_out20p0;


}
