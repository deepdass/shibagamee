code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 circlecolor : source_color;
uniform float extraop : hint_range(0.0, 1.0);
uniform vec2 speed;
uniform sampler2D tex_frg_12;
uniform sampler2D tex_frg_13;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = circlecolor;


// FloatParameter:8
	float n_out8p0 = extraop;


// Input:4
	float n_out4p0 = TIME;


// Vector2Parameter:6
	vec2 n_out6p0 = speed;


// VectorOp:5
	vec2 n_out5p0 = vec2(n_out4p0) * n_out6p0;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, n_out3p0);
	float n_out12p1 = n_out12p0.r;


// FloatOp:9
	float n_out9p0 = n_out8p0 + n_out12p1;


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, UV);


// FloatOp:11
	float n_out11p0 = n_out9p0 * n_out13p0.x;


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out11p0;


}
"
